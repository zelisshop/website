DB_HOST=your-database-host
DB_PORT=25060
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=defaultdb
DB_SSL_CA_PATH=./ca-certificate.crt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-long-random-secret

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_API_VERSION=2026-05-20
SQUARE_PAGE_SIZE=12
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/api/square/webhook

BUCKET_ENDPOINT=https://zelis.syd1.digitaloceanspaces.com
BUCKET_PUBLIC_URL=https://zelis.syd1.digitaloceanspaces.com
# Optional. Use this when DigitalOcean Spaces CDN is enabled.
# BUCKET_CDN_URL=https://zelis.syd1.cdn.digitaloceanspaces.com
BUCKET_NAME=zelis
BUCKET_REGION=syd1
BUCKET_ACCESS_KEY=your-spaces-access-key
BUCKET_SECRET_KEY=your-spaces-secret-key
# Also supported:
# BUCKET_ACCESS_KEY_ID=your-spaces-access-key
# BUCKET_SECRET_ACCESS_KEY=your-spaces-secret-key
# DO_SPACES_KEY=your-spaces-access-key
# DO_SPACES_SECRET=your-spaces-secret-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
STORE_NAME=Zelis Shop
